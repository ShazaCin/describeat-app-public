# DescribeAT App — Environment Configuration
#
# Copy this file to `.env.local` and fill in YOUR values.
# Never commit `.env.local` — it is gitignored.
# All values here are PLACEHOLDERS — do not point at Shazacin infrastructure.

# ----------------------------------------------------------------------------
# Backend API endpoint (your self-hosted deployment, or a local mock)
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.example.com

# ----------------------------------------------------------------------------
# Audio sync / matching engine endpoint
# This is the endpoint the app sends ambient-audio fingerprints to for matching
# ----------------------------------------------------------------------------
VITE_SYNC_API_URL=https://sync.example.com

# ----------------------------------------------------------------------------
# CDN for AD audio track playback
# ----------------------------------------------------------------------------
VITE_CDN_BASE_URL=https://cdn.example.com

# ----------------------------------------------------------------------------
# Optional: AWS Amplify auth configuration
# Leave blank to run without authentication
# ----------------------------------------------------------------------------
VITE_AWS_REGION=
VITE_AWS_COGNITO_USER_POOL_ID=
VITE_AWS_COGNITO_USER_POOL_CLIENT_ID=
VITE_AWS_COGNITO_IDENTITY_POOL_ID=
VITE_AWS_COGNITO_OAUTH_DOMAIN=
VITE_AWS_OAUTH_REDIRECT_SIGNIN=https://app.example.com/
VITE_AWS_OAUTH_REDIRECT_SIGNOUT=https://app.example.com/

# ----------------------------------------------------------------------------
# Optional: AppSync GraphQL endpoint
# ----------------------------------------------------------------------------
VITE_AWS_APPSYNC_ENDPOINT=
VITE_AWS_APPSYNC_REGION=
VITE_AWS_APPSYNC_AUTH_TYPE=API_KEY

# ----------------------------------------------------------------------------
# Optional: Firebase Cloud Messaging (push notifications)
# Leave blank to disable push notifications
# ----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ----------------------------------------------------------------------------
# Optional: Analytics
# Set to "true" only if you have configured your own analytics endpoint
# ----------------------------------------------------------------------------
VITE_ANALYTICS_ENABLED=false

# ----------------------------------------------------------------------------
# PWA / Service Worker
# ----------------------------------------------------------------------------
# Public URL where the app is hosted (used for service worker scope and manifest)
VITE_PUBLIC_URL=https://app.example.com